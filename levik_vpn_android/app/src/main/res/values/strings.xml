    <string name="relay_guide_open">VK sign-in · how to connect</string>
    <string name="relay_guide_title">Connecting through VK</string>
    <string name="relay_guide_intro">This server helps you access the internet when your provider only allows selected services. It requires signing in to a VK account — this is an expected part of connecting.</string>
    <string name="relay_guide_step_network">Turn on mobile data. VK must be accessible on your network.</string>
    <string name="relay_guide_step_login">A VK page will open when you connect. Sign in to your account and confirm the sign-in if asked. If you are already signed in, this step may happen automatically.</string>
    <string name="relay_guide_step_return">Wait for sign-in to finish: the app will continue connecting. Check that the status says “Connected” before using the internet.</string>
    <string name="relay_guide_alternative">Cancel VK sign-in and choose another server. Availability depends on your network.</string>
    <string name="relay_guide_continue">Got it, continue</string>
    <string name="relay_guide_done">Close</string>
